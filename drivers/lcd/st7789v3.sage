0x7F,0x08,0x04,0x04,0x78, 0x00,0x44,0x7D,0x40,0x00, 0x20,0x40,0x44,0x3D,0x00, 0x00,0x7F,0x10,0x28,0x44,
0x00,0x41,0x7F,0x40,0x00, 0x7C,0x04,0x18,0x04,0x78, 0x7C,0x08,0x04,0x04,0x78, 0x38,0x44,0x44,0x44,0x38,
0x7C,0x14,0x14,0x14,0x08, 0x08,0x14,0x14,0x18,0x7C, 0x7C,0x08,0x04,0x04,0x08, 0x48,0x54,0x54,0x54,0x20,
0x04,0x3F,0x44,0x40,0x20, 0x3C,0x40,0x40,0x20,0x7C, 0x1C,0x20,0x40,0x20,0x1C, 0x3C,0x40,0x30,0x40,0x3C,
0x44,0x28,0x10,0x28,0x44, 0x0C,0x50,0x50,0x50,0x3C, 0x44,0x64,0x54,0x4C,0x44, 0x00,0x08,0x36,0x41,0x00,
0x00,0x00,0x7F,0x00,0x00, 0x00,0x41,0x36,0x08,0x00, 0x08,0x08,0x2A,0x1C,0x08
]

var _lcd_ready = false

proc _cs(val):
    hw.gpio_put(LCD_PIN_CS, val)

proc _dc(val):
    hw.gpio_put(LCD_PIN_DC, val)

proc lcd_write_cmd(cmd):
    _cs(true)
    _dc(false)
    _cs(false)
    hw.spi_write(0, cmd)
    _cs(true)

proc lcd_write_data(byte):
    _cs(true)
    _dc(true)
    _cs(false)
    hw.spi_write(0, byte)
    _cs(true)

proc lcd_write_data_n(vals):
    _cs(true)
    _dc(true)
    _cs(false)
    hw.spi_write(0, vals)
    _cs(true)

# lcd_init(): power up backlight, reset the panel, allocate the framebuffer
# and run the official ST7789V3 register init. Returns true on success.
proc lcd_init():
    hw.gpio_init(LCD_PIN_BL)
    hw.gpio_set_dir(LCD_PIN_BL, true)
    hw.gpio_put(LCD_PIN_BL, true)
    hw.gpio_init(LCD_PIN_CS)
    hw.gpio_set_dir(LCD_PIN_CS, true)
    hw.gpio_init(LCD_PIN_DC)
    hw.gpio_set_dir(LCD_PIN_DC, true)
    hw.gpio_init(LCD_PIN_RST)
    hw.gpio_set_dir(LCD_PIN_RST, true)
    _cs(true)
    _dc(true)
    if hw.spi_init(0, 62500000) == 0:
        return false
    hw.gpio_put(LCD_PIN_RST, false)
    hw.delay_ms(10)
    hw.gpio_put(LCD_PIN_RST, true)
    hw.delay_ms(120)
    if hw.lcd_fb_init(LCD_WIDTH, LCD_HEIGHT) != 1:
        return false
    lcd_write_cmd(0x36)
    lcd_write_data(0x70)
    lcd_write_cmd(0x3A)
    lcd_write_data(0x05)
    lcd_write_cmd(0xB2)
    lcd_write_data_n([0x0C, 0x0C, 0x00, 0x33, 0x33])
    lcd_write_cmd(0xB7)
    lcd_write_data(0x35)
    lcd_write_cmd(0xBB)
    lcd_write_data(0x35)
    lcd_write_cmd(0xC0)
    lcd_write_data(0x2C)
    lcd_write_cmd(0xC2)
    lcd_write_data(0x01)
    lcd_write_cmd(0xC3)
    lcd_write_data(0x13)
    lcd_write_cmd(0xC4)
    lcd_write_data(0x20)
    lcd_write_cmd(0xC6)
    lcd_write_data(0x0F)
    lcd_write_cmd(0xD0)
    lcd_write_data_n([0xA4, 0xA1])
    lcd_write_cmd(0xD6)
    lcd_write_data(0xA1)
    lcd_write_cmd(0xE0)
    lcd_write_data_n([0xF0, 0x00, 0x04, 0x04, 0x04, 0x05, 0x29, 0x33, 0x3E, 0x38, 0x12, 0x12, 0x28, 0x30])
    lcd_write_cmd(0xE1)
    lcd_write_data_n([0xF0, 0x07, 0x0A, 0x0D, 0x0B, 0x07, 0x28, 0x33, 0x3E, 0x36, 0x14, 0x14, 0x29, 0x23])
    lcd_write_cmd(0x21)
    lcd_write_cmd(0x11)
    hw.delay_ms(120)
    lcd_write_cmd(0x29)
    _lcd_ready = true
    return true

proc lcd_ready():
    return _lcd_ready

# lcd_set_rotation(mode): MadCTL for the four standard orientations.
# Only mode 0 (landscape, as tested) is guaranteed on this panel.
proc lcd_set_rotation(mode):
    var table = [0x70, 0xA0, 0x00, 0xC0]
    var mad = table[0]
    if mode >= 0 and mode <= 3:
        mad = table[mode]
    lcd_write_cmd(0x36)
    lcd_write_data(mad)

# lcd_set_window(x0, y0, x1, y1): CASET/RASET with the verified Y offset,
# then RAMWR (0x2C). Coordinates are inclusive.
proc lcd_set_window(x0, y0, x1, y1):
    lcd_write_cmd(0x2A)
    lcd_write_data(x0 >> 8)
    lcd_write_data(x0 & 0xFF)
    lcd_write_data(x1 >> 8)
    lcd_write_data(x1 & 0xFF)
    lcd_write_cmd(0x2B)
    var yb0 = y0 + LCD_Y_OFF
    var yb1 = y1 + LCD_Y_OFF
    lcd_write_data(yb0 >> 8)
    lcd_write_data(yb0 & 0xFF)
    lcd_write_data(yb1 >> 8)
    lcd_write_data(yb1 & 0xFF)
    lcd_write_cmd(0x2C)

# lcd_show(): push the whole framebuffer to the panel (RAMWR payload).
proc lcd_show():
    _cs(true)
    _dc(true)
    _cs(false)
    hw.lcd_fb_flush_bytes(LCD_BYTES)
    _cs(true)

# --- Framebuffer drawing primitives --------------------------------------
proc lcd_fill(color):
    hw.lcd_fb_fill(color)

proc lcd_pixel(x, y, color):
    hw.lcd_fb_pixel(x, y, color)

proc lcd_fill_rect(x, y, w, h, color):
    var yy = y
    while yy < y + h:
        var xx = x
        while xx < x + w:
            hw.lcd_fb_pixel(xx, yy, color)
            xx = xx + 1
        yy = yy + 1

proc lcd_rect(x, y, w, h, color):
    var i = 0
    while i < w:
        hw.lcd_fb_pixel(x + i, y, color)
        hw.lcd_fb_pixel(x + i, y + h - 1, color)
        i = i + 1
    i = 0
    while i < h:
        hw.lcd_fb_pixel(x, y + i, color)
        hw.lcd_fb_pixel(x + w - 1, y + i, color)
        i = i + 1

# lcd_line(x0, y0, x1, y1, color): Bresenham.
proc lcd_line(x0, y0, x1, y1, color):
    var dx = x1 - x0
    var dy = y1 - y0
    var sx = 1
    var sy = 1
    if dx < 0:
        dx = -dx
        sx = -1
    if dy < 0:
        dy = -dy
        sy = -1
    var err = dx - dy
    var x = x0
    var y = y0
    while x != x1 or y != y1:
        hw.lcd_fb_pixel(x, y, color)
        var e2 = 2 * err
        if e2 > -dy:
            err = err - dy
            x = x + sx
        if e2 < dx:
            err = err + dx
            y = y + sy
    hw.lcd_fb_pixel(x1, y1, color)

# lcd_text(x, y, text, color, scale): 5x7 font, one char per 6x8 cell.
proc lcd_text(x, y, text, color, scale):
    var cx = x
    var i = 0
    while i < len(text):
        var ch = ord(text[i])
        if ch >= 32 and ch <= 126:
            var base = (ch - 32) * 5
            var col = 0
            while col < 5:
                var row = 0
                while row < 7:
                    if (LCD_FONT[base + col] & (1 << row)) != 0:
                        var sx = 0
                        while sx < scale:
                            var sy = 0
                            while sy < scale:
                                hw.lcd_fb_pixel(cx + col * scale + sx, y + row * scale + sy, color)
                                sy = sy + 1
                            sx = sx + 1
                    row = row + 1
                col = col + 1
        i = i + 1
        cx = cx + 6 * scale
