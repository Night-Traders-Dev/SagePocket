# drivers/lcd/st7789v3.sage - ST7789V3 172x320 LCD driver (Waveshare RP2350-LCD-1.47).
#
# Verified configuration (official MicroPython demo RP2350-LCD-1.47.py):
#   - SPI0 master, mode 0 (SPI_CPOL_0/SPI_CPHA_0, MSB first), 62.5 MHz
#   - Pins: CS=17, DC=16, RST=20, BL=21, SCK=18, MOSI=19
#   - MadCTL 0x70, landscape 320x172 framebuffer, RASET Y offset +34 (0x22),
#     CASET no offset. (The C demo's offsets are buggy; the MicroPython demo
#     is the tested reference.)
#   - Panel reads BGR565: a red pixel must be written as 0x07E0, green as
#     0x001F, blue as 0xF800 (see COLOR_* below).
#   - Framebuffer is C-backed (hw.lcd_fb_*): 320x172x2 = 110,080 bytes.

import hw

# --- Pins ----------------------------------------------------------------
var LCD_PIN_CS = 17
var LCD_PIN_DC = 16
var LCD_PIN_RST = 20
var LCD_PIN_BL = 21

# --- Panel geometry (landscape) ------------------------------------------
var LCD_WIDTH = 320
var LCD_HEIGHT = 172
var LCD_BYTES = 110080
var LCD_Y_OFF = 34

# --- Colors (BGR565 write values, verified on panel) ---------------------
var COLOR_BLACK = 0x0000
var COLOR_RED = 0x07E0
var COLOR_GREEN = 0x001F
var COLOR_BLUE = 0xF800
var COLOR_YELLOW = 0x07FF
var COLOR_MAGENTA = 0xF81F
var COLOR_CYAN = 0xFFE0
var COLOR_WHITE = 0xFFFF

# --- Font: 5x7, column-major, ASCII 32..126, bit 0 = top row -------------
var LCD_FONT = [
0x00,0x00,0x00,0x00,0x00, 0x00,0x00,0x5F,0x00,0x00, 0x00,0x07,0x00,0x07,0x00, 0x14,0x7F,0x14,0x7F,0x14,
0x24,0x2A,0x7F,0x2A,0x12, 0x23,0x13,0x08,0x64,0x62, 0x36,0x49,0x55,0x22,0x50, 0x00,0x05,0x03,0x00,0x00,
0x00,0x1C,0x22,0x41,0x00, 0x00,0x41,0x22,0x1C,0x00, 0x08,0x2A,0x1C,0x2A,0x08, 0x08,0x08,0x3E,0x08,0x08,
0x00,0x50,0x30,0x00,0x00, 0x08,0x08,0x08,0x08,0x08, 0x00,0x60,0x60,0x00,0x00, 0x20,0x10,0x08,0x04,0x02,
0x3E,0x51,0x49,0x45,0x3E, 0x00,0x42,0x7F,0x40,0x00, 0x42,0x61,0x51,0x49,0x46, 0x21,0x41,0x45,0x4B,0x31,
0x18,0x14,0x12,0x7F,0x10, 0x27,0x45,0x45,0x45,0x39, 0x3C,0x4A,0x49,0x49,0x30, 0x01,0x71,0x09,0x05,0x03,
0x36,0x49,0x49,0x49,0x36, 0x06,0x49,0x49,0x29,0x1E, 0x00,0x36,0x36,0x00,0x00, 0x00,0x56,0x36,0x00,0x00,
0x00,0x08,0x14,0x22,0x41, 0x14,0x14,0x14,0x14,0x14, 0x41,0x22,0x14,0x08,0x00, 0x02,0x01,0x51,0x09,0x06,
0x32,0x49,0x79,0x41,0x3E, 0x7C,0x12,0x11,0x12,0x7C, 0x7F,0x49,0x49,0x49,0x36, 0x3E,0x41,0x41,0x41,0x22,
0x7F,0x41,0x41,0x22,0x1C, 0x7F,0x49,0x49,0x49,0x41, 0x7F,0x09,0x09,0x01,0x01, 0x3E,0x41,0x41,0x51,0x32,
0x7F,0x08,0x08,0x08,0x7F, 0x00,0x41,0x7F,0x41,0x00, 0x20,0x40,0x41,0x3F,0x01, 0x7F,0x08,0x14,0x22,0x41,
0x7F,0x40,0x40,0x40,0x40, 0x7F,0x02,0x04,0x02,0x7F, 0x7F,0x04,0x08,0x10,0x7F, 0x3E,0x41,0x41,0x41,0x3E,
0x7F,0x09,0x09,0x09,0x06, 0x3E,0x41,0x51,0x21,0x5E, 0x7F,0x09,0x19,0x29,0x46, 0x46,0x49,0x49,0x49,0x31,
0x01,0x01,0x7F,0x01,0x01, 0x3F,0x40,0x40,0x40,0x3F, 0x1F,0x20,0x40,0x20,0x1F, 0x7F,0x20,0x18,0x20,0x7F,
0x63,0x14,0x08,0x14,0x63, 0x03,0x04,0x78,0x04,0x03, 0x61,0x51,0x49,0x45,0x43, 0x00,0x00,0x7F,0x41,0x41,
0x02,0x04,0x08,0x10,0x20, 0x41,0x41,0x7F,0x00,0x00, 0x04,0x02,0x01,0x02,0x04, 0x40,0x40,0x40,0x40,0x40,
0x00,0x01,0x02,0x04,0x00, 0x20,0x54,0x54,0x54,0x78, 0x7F,0x48,0x44,0x44,0x38, 0x38,0x44,0x44,0x44,0x20,
